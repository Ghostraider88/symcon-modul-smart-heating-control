{
    "name": "symcon/module-template",
    "description": "A starter library for IP-Symcon PHP modules.",
    "type": "symcon-module",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.65",
        "phpunit/phpunit": "^10.1"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "vendor-dir": ".tools/vendor"
    },
    "scripts": {
        "test": "phpunit tests --configuration tests/phpunit.xml",
        "style:check": [
            "php .tools/json-check.php",
            "php-cs-fixer fix --config=.style/.php-cs-fixer.php --dry-run --diff --allow-risky=yes"
        ],
        "style:fix": [
            "php .tools/json-check.php",
            "php-cs-fixer fix --config=.style/.php-cs-fixer.php --allow-risky=yes"
        ]
    }
}
